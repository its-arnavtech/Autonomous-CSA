# Copying this file is optional. `pnpm staging:local:up` generates
# run-output/staging-local.env with staging-only local secrets.
#
# Do not commit real secrets, generated passwords, database dumps, or logs.

COMPOSE_PROJECT_NAME=autonomous-csa-staging
STAGING_LOCAL_ENV_FILE=.env.staging.example
APP_ENV=staging
NODE_ENV=production
ALLOW_LOCAL_STAGING=true
APP_VERSION=0.11.0-local
GIT_SHA=local
BUILD_TIMESTAMP=1970-01-01T00:00:00.000Z

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-generated-postgres-password
POSTGRES_DB=agentic_support
DATABASE_URL=postgresql://postgres:replace-with-local-generated-postgres-password@postgres:5432/agentic_support

REDIS_PASSWORD=replace-with-local-generated-redis-password
REDIS_URL=redis://:replace-with-local-generated-redis-password@redis:6379/0

JWT_ACCESS_SECRET=replace-with-local-generated-access-secret
JWT_REFRESH_SECRET=replace-with-local-generated-refresh-secret
METRICS_AUTH_TOKEN=replace-with-local-generated-metrics-token

API_BASE_URL=http://api:3001
WEB_PUBLIC_URL=http://web:3000
INTERNAL_WEB_URL=http://web:3000
INTERNAL_API_URL=http://api:3001
CORS_ALLOWED_ORIGINS=http://web:3000,http://localhost:3100
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_NAME_PREFIX=stg_local

STAGING_OWNER_EMAIL=owner@staging.local
STAGING_ADMIN_EMAIL=admin@staging.local
STAGING_AGENT_EMAIL=agent@staging.local
STAGING_VIEWER_EMAIL=viewer@staging.local
STAGING_USER_PASSWORD_HASH=replace-with-generated-argon2id-hash
STAGING_SMOKE_EMAIL=owner@staging.local
STAGING_SMOKE_PASSWORD=replace-with-generated-smoke-password

AI_PROVIDER=deterministic
AI_ENABLE_FALLBACK=true
METRICS_ENABLED=true
SWAGGER_ENABLED=false
TRUST_PROXY=true
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PRETTY=false
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=15000
WORKER_SHUTDOWN_GRACE_MS=30000
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_REMOVE_ON_COMPLETE_COUNT=100
QUEUE_REMOVE_ON_FAIL_COUNT=200
QUEUE_STALLED_INTERVAL_MS=30000
QUEUE_MAX_STALLED_COUNT=1
RATE_LIMIT_AUTH_WINDOW_MS=15m
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_FAIL_MODE=closed
RATE_LIMIT_API_WINDOW_MS=60s
RATE_LIMIT_API_MAX_REQUESTS=120
RATE_LIMIT_API_FAIL_MODE=open
# Phase 12 channel integration defaults. Keep mock mode for zero-spend staging.
CHANNEL_PROVIDER_MODE=mock
MOCK_CHANNEL_WEBHOOK_SECRET=mock-webhook-secret
CHANNEL_WEBHOOK_PAYLOAD_LIMIT_BYTES=262144
CHANNEL_DELIVERY_QUEUE_NAME=channel-delivery
CHANNEL_DELIVERY_MAX_ATTEMPTS=3
CHANNEL_DELIVERY_RETRY_BASE_DELAY_MS=1000
CHANNEL_DELIVERY_LEASE_MS=120000
CHANNEL_INBOUND_DISPATCH_LEASE_MS=120000
CHANNEL_INBOUND_DISPATCH_RETRY_DELAY_MS=5000
CHANNEL_INBOUND_DISPATCH_POLL_INTERVAL_MS=30000
CHANNEL_MAX_ATTACHMENT_COUNT=10
CHANNEL_MAX_ATTACHMENT_SIZE_BYTES=25000000
CHANNEL_OUTBOUND_SENDING_ENABLED=true
MOCK_CHANNEL_FAILURE_MODE=
