{
  "name": "@agentic-support/db",
  "version": "1.0.0",
  "description": "Autonomous CSA Prisma schema and database utilities",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:check": "tsx scripts/migrate-check.ts",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "db:seed:staging": "tsx scripts/staging-seed.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "maintenance:cleanup": "tsx scripts/maintenance-cleanup.ts",
    "lint": "echo \"No lint configured for @agentic-support/db\"",
    "test": "echo \"No tests configured for @agentic-support/db\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "prisma": "^6.19.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
