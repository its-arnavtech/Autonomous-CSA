generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tickets   Ticket[]
  messages  TicketMessage[]
  agentRuns AgentRun[]
  events    AgentEvent[]
  settings  OrganizationSettings?
  approvals HumanApproval[]
  drafts    OutboundDraft[]
  memberships       OrganizationMembership[]
  knowledgeArticles   KnowledgeArticle[]
  knowledgeRetrievals KnowledgeRetrieval[]
  operationalFailures OperationalFailure[]
  channelConnections  ChannelConnection[]
  externalCustomers   ExternalCustomer[]
  conversations       Conversation[]
  externalMessages    ExternalMessage[]
  messageAttachments  MessageAttachment[]
  webhookReceipts     WebhookReceipt[]
  outboundMessages    OutboundMessage[]
  deliveryAttempts    DeliveryAttempt[]
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  normalizedEmail String                   @unique
  passwordHash    String
  displayName     String?
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships     OrganizationMembership[]
  refreshSessions RefreshSession[]
  reviewedApprovals HumanApproval[] @relation("HumanApprovalReviewedByUser")
  createdDrafts     OutboundDraft[] @relation("OutboundDraftCreatedByUser")
  approvedDrafts    OutboundDraft[] @relation("OutboundDraftApprovedByUser")
  sentDrafts        OutboundDraft[] @relation("OutboundDraftSentByUser")
  approvedOutboundMessages OutboundMessage[] @relation("OutboundMessageApprovedByUser")
  resolvedOperationalFailures OperationalFailure[] @relation("OperationalFailureResolvedByUser")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model RefreshSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id            String          @id @default(uuid())
  orgId         String
  subject       String
  status        TicketStatus
  priority      TicketPriority
  customerEmail String
  customerName  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
  agentRuns     AgentRun[]
  events        AgentEvent[]
  approvals     HumanApproval[]
  drafts        OutboundDraft[]
  retrievals    KnowledgeRetrieval[]
  conversations Conversation[]
  outboundMessages OutboundMessage[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, updatedAt])
}

model TicketMessage {
  id           String           @id @default(uuid())
  orgId        String
  ticketId     String
  direction    MessageDirection  @default(INBOUND)
  status       MessageStatus     @default(RECEIVED)
  body         String
  createdAt    DateTime         @default(now())
  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orgId, ticketId, createdAt])
}

model AgentRun {
  id              String                @id @default(uuid())
  orgId           String
  ticketId        String
  correlationId   String?
  status          AgentRunStatus
  trigger         AgentRunTrigger
  queuedAt        DateTime              @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  attemptCount    Int                   @default(0)
  totalCostCents  Int                   @default(0)
  errorCode       String?
  errorMessage    String?
  lastErrorCode   String?
  lastErrorMessage String?
  failureStage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ticket          Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events          AgentEvent[]
  approvals       HumanApproval[]
  drafts          OutboundDraft[]
  steps           AgentStep[]
  retrievals      KnowledgeRetrieval[]
  guardrailChecks AgentGuardrailCheck[]

  @@index([ticketId])
  @@index([correlationId])
  @@index([orgId, status, createdAt])
}

model AgentStep {
  id                 String          @id @default(uuid())
  orgId              String
  agentRunId         String
  stepType           AgentStepType
  status             AgentStepStatus
  inputJson          Json?
  outputJson         Json?
  errorMessage       String?
  provider           String?
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  estimatedCostCents Int?
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  retryCount         Int             @default(0)
  errorCode          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  agentRun           AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([orgId, agentRunId, stepType])
  @@index([orgId, createdAt])
}

model KnowledgeArticle {
  id           String                 @id @default(uuid())
  orgId        String
  title        String
  body         String
  status       KnowledgeArticleStatus @default(DRAFT)
  tags         String[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, updatedAt])
  @@index([orgId, createdAt])
}

model KnowledgeRetrieval {
  id           String       @id @default(uuid())
  orgId        String
  ticketId     String
  agentRunId   String?
  query        String
  resultCount  Int
  resultsJson  Json
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([orgId, agentRunId])
}

model AgentEvent {
  id           String          @id @default(uuid())
  orgId        String
  ticketId     String
  runId        String?
  correlationId String?
  type         AgentEventType
  sequence     Int
  payload      Json
  latencyMs    Int?
  costCents    Int?
  createdAt    DateTime        @default(now())
  ticket       Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([runId])
  @@index([correlationId])
  @@index([orgId, ticketId, sequence])
}

model OrganizationSettings {
  id                              String       @id @default(uuid())
  orgId                           String       @unique
  autoRespond                     Boolean      @default(false)
  requireHumanApproval            Boolean      @default(true)
  maxAgentCostCents               Int          @default(50)
  maxAutoSendCostCents            Int          @default(25)
  requireApprovalForLowConfidence Boolean      @default(true)
  blockOnPiiDetection             Boolean      @default(true)
  minCriticCompletenessScore      Int          @default(70)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  organization                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model HumanApproval {
  id               String         @id @default(uuid())
  orgId            String
  ticketId         String
  agentRunId       String?
  outboundDraftId  String?
  reviewedByUserId String?
  status           ApprovalStatus
  proposedResponse String?
  reviewerNote     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun         AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  outboundDraft    OutboundDraft? @relation(fields: [outboundDraftId], references: [id], onDelete: SetNull)
  reviewedByUser   User?          @relation("HumanApprovalReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
  @@index([orgId, outboundDraftId])
  @@index([reviewedByUserId])
}

model OutboundDraft {
  id             String       @id @default(uuid())
  orgId          String
  ticketId       String
  agentRunId     String?
  body           String
  status         DraftStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sentAt         DateTime?
  createdBy      String       @default("agent_stub")
  approvedBy     String?
  sentBy         String?
  createdByType  ActorType    @default(AGENT)
  createdByUserId String?
  approvedByType ActorType?
  approvedByUserId String?
  sentByType     ActorType?
  sentByUserId   String?
  rejectedReason String?
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun       AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  approvals      HumanApproval[]
  outboundMessages OutboundMessage[]
  createdByUser  User?        @relation("OutboundDraftCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUser User?        @relation("OutboundDraftApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sentByUser     User?        @relation("OutboundDraftSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([sentByUserId])
}

model AgentGuardrailCheck {
  id            String            @id @default(uuid())
  orgId         String
  ticketId      String
  agentRunId    String?
  guardrailType GuardrailType
  decision      GuardrailDecision
  reason        String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  agentRun      AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
}

model OperationalFailure {
  id                String        @id @default(uuid())
  organizationId    String?
  queueName         String
  jobName           String
  jobId             String?
  correlationId     String?
  ticketId          String?
  runId             String?
  errorCode         String
  safeErrorMessage  String
  attemptCount      Int
  payloadSummaryJson Json?
  failedAt          DateTime      @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolutionNote    String?
  replayedJobId     String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  resolvedByUser    User?         @relation("OperationalFailureResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, failedAt])
  @@index([correlationId])
  @@index([runId])
  @@index([ticketId])
}

model ChannelConnection {
  id                            String                  @id @default(uuid())
  publicId                      String                  @unique @default(uuid())
  organizationId                String
  provider                      ChannelProvider
  displayName                   String
  status                        ChannelConnectionStatus @default(ACTIVE)
  externalAccountId             String?
  inboundAddress                String?
  secretReference               String?
  webhookSigningSecretReference String?
  config                        Json?
  isDefault                     Boolean                 @default(false)
  lastSuccessfulEventAt         DateTime?
  lastErrorAt                   DateTime?
  lastErrorCode                 String?
  lastErrorRedacted             String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  disabledAt                    DateTime?
  organization                  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalCustomers             ExternalCustomer[]
  conversations                 Conversation[]
  externalMessages              ExternalMessage[]
  webhookReceipts               WebhookReceipt[]
  outboundMessages              OutboundMessage[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model ExternalCustomer {
  id                  String            @id @default(uuid())
  organizationId      String
  channelConnectionId String
  externalCustomerId  String?
  email               String?
  normalizedEmail     String?
  displayName         String?
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  conversations       Conversation[]

  @@unique([organizationId, channelConnectionId, externalCustomerId])
  @@unique([organizationId, channelConnectionId, normalizedEmail])
  @@index([organizationId])
  @@index([channelConnectionId])
  @@index([normalizedEmail])
}

model Conversation {
  id                  String             @id @default(uuid())
  organizationId      String
  channelConnectionId String
  externalCustomerId  String?
  ticketId            String?
  externalThreadId    String?
  subject             String?
  status              ConversationStatus @default(OPEN)
  lastMessageAt       DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection  @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  externalCustomer    ExternalCustomer?  @relation(fields: [externalCustomerId], references: [id], onDelete: SetNull)
  ticket              Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  externalMessages    ExternalMessage[]
  outboundMessages    OutboundMessage[]

  @@unique([organizationId, channelConnectionId, externalThreadId])
  @@index([organizationId])
  @@index([channelConnectionId])
  @@index([externalCustomerId])
  @@index([ticketId])
  @@index([lastMessageAt])
}

model ExternalMessage {
  id                       String              @id @default(uuid())
  organizationId           String
  conversationId           String
  channelConnectionId      String
  providerMessageId        String?
  providerEventId          String?
  direction                ExternalMessageDirection
  sender                   Json
  recipients               Json
  subject                  String?
  textBody                 String?
  htmlBody                 String?
  sanitizedHtmlBody        String?
  replyToProviderMessageId String?
  inReplyTo                String?
  references               Json?
  receivedAt               DateTime?
  sentAt                   DateTime?
  metadata                 Json?
  createdAt                DateTime            @default(now())
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation             Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelConnection        ChannelConnection   @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  attachments              MessageAttachment[]
  outboundMessages         OutboundMessage[]

  @@unique([channelConnectionId, providerMessageId])
  @@unique([channelConnectionId, providerEventId])
  @@index([organizationId])
  @@index([conversationId])
  @@index([channelConnectionId])
  @@index([providerMessageId])
  @@index([providerEventId])
  @@index([createdAt])
}

model MessageAttachment {
  id                   String                  @id @default(uuid())
  organizationId       String
  externalMessageId    String
  providerAttachmentId String?
  filename             String
  mimeType             String
  sizeBytes            Int
  contentDisposition   String?
  contentId            String?
  checksum             String?
  status               MessageAttachmentStatus @default(METADATA_ONLY)
  metadata             Json?
  createdAt            DateTime                @default(now())
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalMessage      ExternalMessage         @relation(fields: [externalMessageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([externalMessageId])
  @@index([providerAttachmentId])
  @@index([createdAt])
}

model WebhookReceipt {
  id                     String               @id @default(uuid())
  organizationId         String
  channelConnectionId    String
  provider               ChannelProvider
  providerEventId        String
  eventType              String
  signatureVerified      Boolean              @default(false)
  payloadHash            String
  receivedAt             DateTime             @default(now())
  processedAt            DateTime?
  status                 WebhookReceiptStatus @default(RECEIVED)
  failureCode            String?
  failureMessageRedacted String?
  correlationId          String?
  retryCount             Int                  @default(0)
  metadata               Json?
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection      ChannelConnection    @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)

  @@unique([channelConnectionId, providerEventId])
  @@index([organizationId])
  @@index([channelConnectionId])
  @@index([providerEventId])
  @@index([status])
  @@index([receivedAt])
}

model OutboundMessage {
  id                       String                @id @default(uuid())
  organizationId           String
  conversationId           String
  channelConnectionId      String
  ticketId                 String
  draftId                  String
  externalMessageId        String?
  idempotencyKey           String                @unique
  status                   OutboundMessageStatus @default(PENDING)
  subject                  String?
  textBody                 String
  htmlBody                 String?
  recipients               Json
  providerMessageId        String?
  approvedByUserId         String?
  approvedAt               DateTime?
  queuedAt                 DateTime              @default(now())
  processingStartedAt      DateTime?
  sentAt                   DateTime?
  deliveredAt              DateTime?
  failedAt                 DateTime?
  nextAttemptAt            DateTime?
  attemptCount             Int                   @default(0)
  maxAttempts              Int                   @default(3)
  leaseOwner               String?
  leaseExpiresAt           DateTime?
  lastErrorCode            String?
  lastErrorRedacted        String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation             Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelConnection        ChannelConnection     @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  ticket                   Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  draft                    OutboundDraft         @relation(fields: [draftId], references: [id], onDelete: Restrict)
  externalMessage          ExternalMessage?      @relation(fields: [externalMessageId], references: [id], onDelete: SetNull)
  approvedByUser           User?                 @relation("OutboundMessageApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  deliveryAttempts         DeliveryAttempt[]

  @@unique([channelConnectionId, providerMessageId])
  @@index([organizationId])
  @@index([conversationId])
  @@index([channelConnectionId])
  @@index([ticketId])
  @@index([draftId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model DeliveryAttempt {
  id                  String                 @id @default(uuid())
  organizationId      String
  outboundMessageId   String
  attemptNumber       Int
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  outcome             DeliveryAttemptOutcome
  providerStatusCode  Int?
  providerErrorCode   String?
  retryable           Boolean                @default(false)
  responseMetadata    Json?
  errorRedacted       String?
  correlationId       String?
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboundMessage     OutboundMessage        @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  @@unique([outboundMessageId, attemptNumber])
  @@index([organizationId])
  @@index([outboundMessageId])
  @@index([startedAt])
}

enum TicketStatus {
  OPEN
  PENDING
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  DRAFTED
  SENT
}

enum DraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  CANCELLED
}

enum AgentStepType {
  ROUTER
  RETRIEVER
  RESOLVER
  CRITIC
}

enum AgentStepStatus {
  STARTED
  SUCCEEDED
  FAILED
  BLOCKED
}

enum AgentRunTrigger {
  TICKET_CREATED
  HUMAN_REQUESTED_RETRY
  SCHEDULED
}

enum AgentEventType {
  RUN_QUEUED
  RUN_STARTED
  ROUTER_STARTED
  ROUTER_DECISION
  RETRIEVER_STARTED
  RETRIEVER_RESULTS
  KNOWLEDGE_USED
  KNOWLEDGE_NOT_FOUND
  RESOLVER_STARTED
  RESOLVER_DRAFTED
  CRITIC_STARTED
  CRITIC_REVIEWED
  CRITIC_BLOCKED
  DRAFT_CREATED
  DRAFT_EDITED
  DRAFT_APPROVED
  DRAFT_REJECTED
  DRAFT_AUTO_APPROVED
  DRAFT_SENT
  OUTBOUND_MESSAGE_CREATED
  HUMAN_APPROVAL_CREATED
  AGENT_STEP_FAILED
  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED
  RUN_FINISHED
  RUN_FAILED
  GUARDRAIL_STARTED
  GUARDRAIL_CHECK_PASSED
  GUARDRAIL_REQUIRES_APPROVAL
  GUARDRAIL_BLOCKED
  GUARDRAIL_PII_DETECTED
  GUARDRAIL_SECRET_DETECTED
  GUARDRAIL_COST_LIMIT_EXCEEDED
  GUARDRAIL_KNOWLEDGE_GROUNDING_FAILED
  LLM_CALL_STARTED
  LLM_CALL_SUCCEEDED
  LLM_CALL_FAILED
  LLM_FALLBACK_USED
  LLM_USAGE_RECORDED
  CHANNEL_CONNECTION_CREATED
  CHANNEL_CONNECTION_UPDATED
  CHANNEL_CONNECTION_DISABLED
  CHANNEL_CONNECTION_ENABLED
  CHANNEL_CONNECTION_TESTED
  CHANNEL_WEBHOOK_RECEIVED
  CHANNEL_WEBHOOK_DUPLICATE
  CHANNEL_WEBHOOK_REJECTED
  CHANNEL_CUSTOMER_MATCHED
  CHANNEL_CONVERSATION_CREATED
  CHANNEL_MESSAGE_RECEIVED
  CHANNEL_TICKET_CREATED
  CHANNEL_ATTACHMENT_RECORDED
  CHANNEL_DRAFT_APPROVED_FOR_DELIVERY
  CHANNEL_OUTBOUND_QUEUED
  CHANNEL_DELIVERY_ATTEMPT_STARTED
  CHANNEL_DELIVERY_RETRY_SCHEDULED
  CHANNEL_MESSAGE_SENT
  CHANNEL_MESSAGE_DELIVERED
  CHANNEL_MESSAGE_FAILED
  CHANNEL_MESSAGE_DEAD_LETTERED
  CHANNEL_MESSAGE_REPLAYED
  CHANNEL_OUTBOUND_CANCELLED
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GuardrailDecision {
  ALLOW
  REQUIRE_APPROVAL
  BLOCK
}

enum GuardrailType {
  COST_LIMIT
  SAFETY_POLICY
  KNOWLEDGE_GROUNDING
  PII_DETECTION
  SECRET_DETECTION
  AUTO_SEND_POLICY
}

enum OrganizationRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

enum ChannelProvider {
  MOCK_EMAIL
  GENERIC_EMAIL
}

enum ChannelConnectionStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ExternalMessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAttachmentStatus {
  METADATA_ONLY
  AVAILABLE
  REJECTED
  QUARANTINED
}

enum WebhookReceiptStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  RETRY_SCHEDULED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum DeliveryAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  UNKNOWN
}
