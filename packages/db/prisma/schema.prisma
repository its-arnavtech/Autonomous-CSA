generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tickets   Ticket[]
  messages  TicketMessage[]
  agentRuns AgentRun[]
  events    AgentEvent[]
  settings  OrganizationSettings?
  approvals HumanApproval[]
  drafts    OutboundDraft[]
  memberships       OrganizationMembership[]
  knowledgeArticles   KnowledgeArticle[]
  knowledgeRetrievals KnowledgeRetrieval[]
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  normalizedEmail String                   @unique
  passwordHash    String
  displayName     String?
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships     OrganizationMembership[]
  refreshSessions RefreshSession[]
  reviewedApprovals HumanApproval[] @relation("HumanApprovalReviewedByUser")
  createdDrafts     OutboundDraft[] @relation("OutboundDraftCreatedByUser")
  approvedDrafts    OutboundDraft[] @relation("OutboundDraftApprovedByUser")
  sentDrafts        OutboundDraft[] @relation("OutboundDraftSentByUser")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model RefreshSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id            String          @id @default(uuid())
  orgId         String
  subject       String
  status        TicketStatus
  priority      TicketPriority
  customerEmail String
  customerName  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
  agentRuns     AgentRun[]
  events        AgentEvent[]
  approvals     HumanApproval[]
  drafts        OutboundDraft[]
  retrievals    KnowledgeRetrieval[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, updatedAt])
}

model TicketMessage {
  id           String           @id @default(uuid())
  orgId        String
  ticketId     String
  direction    MessageDirection  @default(INBOUND)
  status       MessageStatus     @default(RECEIVED)
  body         String
  createdAt    DateTime         @default(now())
  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orgId, ticketId, createdAt])
}

model AgentRun {
  id              String                @id @default(uuid())
  orgId           String
  ticketId        String
  status          AgentRunStatus
  trigger         AgentRunTrigger
  startedAt       DateTime?
  finishedAt      DateTime?
  totalCostCents  Int                   @default(0)
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ticket          Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events          AgentEvent[]
  approvals       HumanApproval[]
  drafts          OutboundDraft[]
  steps           AgentStep[]
  retrievals      KnowledgeRetrieval[]
  guardrailChecks AgentGuardrailCheck[]

  @@index([ticketId])
}

model AgentStep {
  id                 String          @id @default(uuid())
  orgId              String
  agentRunId         String
  stepType           AgentStepType
  status             AgentStepStatus
  inputJson          Json?
  outputJson         Json?
  errorMessage       String?
  provider           String?
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  estimatedCostCents Int?
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  agentRun           AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([orgId, agentRunId, stepType])
  @@index([orgId, createdAt])
}

model KnowledgeArticle {
  id           String                 @id @default(uuid())
  orgId        String
  title        String
  body         String
  status       KnowledgeArticleStatus @default(DRAFT)
  tags         String[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, updatedAt])
  @@index([orgId, createdAt])
}

model KnowledgeRetrieval {
  id           String       @id @default(uuid())
  orgId        String
  ticketId     String
  agentRunId   String?
  query        String
  resultCount  Int
  resultsJson  Json
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([orgId, agentRunId])
}

model AgentEvent {
  id           String          @id @default(uuid())
  orgId        String
  ticketId     String
  runId        String?
  type         AgentEventType
  sequence     Int
  payload      Json
  latencyMs    Int?
  costCents    Int?
  createdAt    DateTime        @default(now())
  ticket       Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([runId])
  @@index([orgId, ticketId, sequence])
}

model OrganizationSettings {
  id                              String       @id @default(uuid())
  orgId                           String       @unique
  autoRespond                     Boolean      @default(false)
  requireHumanApproval            Boolean      @default(true)
  maxAgentCostCents               Int          @default(50)
  maxAutoSendCostCents            Int          @default(25)
  requireApprovalForLowConfidence Boolean      @default(true)
  blockOnPiiDetection             Boolean      @default(true)
  minCriticCompletenessScore      Int          @default(70)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  organization                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model HumanApproval {
  id               String         @id @default(uuid())
  orgId            String
  ticketId         String
  agentRunId       String?
  outboundDraftId  String?
  reviewedByUserId String?
  status           ApprovalStatus
  proposedResponse String?
  reviewerNote     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun         AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  outboundDraft    OutboundDraft? @relation(fields: [outboundDraftId], references: [id], onDelete: SetNull)
  reviewedByUser   User?          @relation("HumanApprovalReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
  @@index([orgId, outboundDraftId])
  @@index([reviewedByUserId])
}

model OutboundDraft {
  id             String       @id @default(uuid())
  orgId          String
  ticketId       String
  agentRunId     String?
  body           String
  status         DraftStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sentAt         DateTime?
  createdBy      String       @default("agent_stub")
  approvedBy     String?
  sentBy         String?
  createdByType  ActorType    @default(AGENT)
  createdByUserId String?
  approvedByType ActorType?
  approvedByUserId String?
  sentByType     ActorType?
  sentByUserId   String?
  rejectedReason String?
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentRun       AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  approvals      HumanApproval[]
  createdByUser  User?        @relation("OutboundDraftCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUser User?        @relation("OutboundDraftApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sentByUser     User?        @relation("OutboundDraftSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([sentByUserId])
}

model AgentGuardrailCheck {
  id            String            @id @default(uuid())
  orgId         String
  ticketId      String
  agentRunId    String?
  guardrailType GuardrailType
  decision      GuardrailDecision
  reason        String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  agentRun      AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId, createdAt])
  @@index([agentRunId])
}

enum TicketStatus {
  OPEN
  PENDING
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  DRAFTED
  SENT
}

enum DraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  CANCELLED
}

enum AgentStepType {
  ROUTER
  RETRIEVER
  RESOLVER
  CRITIC
}

enum AgentStepStatus {
  STARTED
  SUCCEEDED
  FAILED
  BLOCKED
}

enum AgentRunTrigger {
  TICKET_CREATED
  HUMAN_REQUESTED_RETRY
  SCHEDULED
}

enum AgentEventType {
  RUN_QUEUED
  RUN_STARTED
  ROUTER_STARTED
  ROUTER_DECISION
  RETRIEVER_STARTED
  RETRIEVER_RESULTS
  KNOWLEDGE_USED
  KNOWLEDGE_NOT_FOUND
  RESOLVER_STARTED
  RESOLVER_DRAFTED
  CRITIC_STARTED
  CRITIC_REVIEWED
  CRITIC_BLOCKED
  DRAFT_CREATED
  DRAFT_EDITED
  DRAFT_APPROVED
  DRAFT_REJECTED
  DRAFT_AUTO_APPROVED
  DRAFT_SENT
  OUTBOUND_MESSAGE_CREATED
  HUMAN_APPROVAL_CREATED
  AGENT_STEP_FAILED
  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED
  RUN_FINISHED
  RUN_FAILED
  GUARDRAIL_STARTED
  GUARDRAIL_CHECK_PASSED
  GUARDRAIL_REQUIRES_APPROVAL
  GUARDRAIL_BLOCKED
  GUARDRAIL_PII_DETECTED
  GUARDRAIL_SECRET_DETECTED
  GUARDRAIL_COST_LIMIT_EXCEEDED
  GUARDRAIL_KNOWLEDGE_GROUNDING_FAILED
  LLM_CALL_STARTED
  LLM_CALL_SUCCEEDED
  LLM_CALL_FAILED
  LLM_FALLBACK_USED
  LLM_USAGE_RECORDED
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GuardrailDecision {
  ALLOW
  REQUIRE_APPROVAL
  BLOCK
}

enum GuardrailType {
  COST_LIMIT
  SAFETY_POLICY
  KNOWLEDGE_GROUNDING
  PII_DETECTION
  SECRET_DETECTION
  AUTO_SEND_POLICY
}

enum OrganizationRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}
