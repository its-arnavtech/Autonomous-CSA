{
  "devDependencies": {
    "bullmq": "5.78.1",
    "cross-env": "^10.1.0",
    "ioredis": "5.11.1",
    "turbo": "^2.10.7"
  },
  "name": "agentic-support-saas",
  "version": "1.0.0",
  "description": "A locally production-validated, multi-tenant agentic customer-support platform.",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "dev": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support REDIS_HOST=localhost REDIS_PORT=6379 turbo dev",
    "build": "turbo build",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:backup:verify": "node scripts/db-backup-verify.mjs",
    "db:generate": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:generate",
    "db:migrate": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:migrate",
    "db:migrate:check": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:migrate:check",
    "db:migrate:deploy": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:migrate:deploy",
    "db:seed": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:seed",
    "db:seed:staging": "pnpm --filter @agentic-support/db db:seed:staging",
    "db:validate": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db db:validate",
    "load:smoke": "k6 run scripts/load/k6-smoke.js",
    "load:staging": "k6 run scripts/load/k6-staging.js",
    "maintenance:cleanup": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support pnpm --filter @agentic-support/db maintenance:cleanup",
    "lint": "pnpm --filter @agentic-support/db build && pnpm --filter @agentic-support/observability build && turbo lint",
    "typecheck": "pnpm --filter @agentic-support/db build && pnpm --filter @agentic-support/observability build && turbo typecheck",
    "test": "turbo test && node --test scripts/lib/postgres-tools.test.mjs scripts/lib/staging-tools.test.mjs",
    "staging:redis:check": "node scripts/redis-bullmq-check.mjs",
    "staging:local:up": "node scripts/staging-local.mjs up",
    "staging:local:down": "node scripts/staging-local.mjs down",
    "staging:local:logs": "node scripts/staging-local.mjs logs",
    "staging:local:reset": "node scripts/staging-local.mjs reset",
    "staging:local:verify": "node scripts/staging-local.mjs verify",
    "staging:local:load": "node scripts/staging-local-load.mjs",
    "staging:local:regression": "node scripts/staging-local-regression.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "channel:mock:inbound": "node scripts/channel-mock.mjs inbound",
    "channel:mock:duplicate": "node scripts/channel-mock.mjs duplicate",
    "channel:mock:invalid-signature": "node scripts/channel-mock.mjs invalid-signature",
    "channel:mock:reply": "node scripts/channel-mock.mjs reply",
    "channel:mock:delivery": "node scripts/channel-mock.mjs delivery",
    "channel:verify": "node scripts/channel-staging-verify.mjs",
    "channel:staging:verify": "node scripts/channel-staging-verify.mjs",
    "channel:test": "pnpm test -- -- channels",
    "demo:up": "node scripts/demo.mjs up",
    "demo:verify": "node scripts/demo.mjs verify",
    "demo:down": "node scripts/demo.mjs down",
    "demo:reset": "node scripts/demo.mjs reset",
    "ci": "pnpm db:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:security": "pnpm audit --audit-level high",
    "ci:docker": "docker build -f apps/api/Dockerfile -t autonomous-csa-api:ci . && docker build -f apps/worker/Dockerfile -t autonomous-csa-worker:ci . && docker build -f apps/web/Dockerfile -t autonomous-csa-web:ci ."
  },
  "pnpm": {
    "overrides": {
      "@nestjs/core": "^11.1.18",
      "@babel/core": "^7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "fast-uri": "^3.1.2",
      "file-type": "^21.3.2",
      "form-data": "^4.0.6",
      "flatted": "^3.4.2",
      "handlebars": "^4.7.9",
      "lodash": "^4.18.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.5",
      "multer": "^2.2.0",
      "path-to-regexp": "^8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "^8.5.15",
      "qs": "^6.15.2",
      "serialize-javascript": "^7.0.3",
      "js-yaml@<=4.1.1": "4.2.0",
      "uuid": "^11.1.1"
    }
  }
}
