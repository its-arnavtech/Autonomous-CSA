DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
API_BASE_URL=http://localhost:3001
# Auth placeholders only. Never commit real production secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set true in production behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_PRETTY=true
LOG_REDACT_FIELDS=authorization,cookie,accessToken,refreshToken,password,passwordHash,tokenHash,AI_API_KEY,OPENAI_API_KEY,ANTHROPIC_API_KEY,DATABASE_URL
APP_VERSION=dev
GIT_SHA=local
HEALTH_CHECK_TIMEOUT_MS=2000
METRICS_ENABLED=true
# METRICS_AUTH_TOKEN=replace-with-a-private-metrics-token
DB_SLOW_QUERY_MS=250
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_REMOVE_ON_COMPLETE_COUNT=100
QUEUE_REMOVE_ON_FAIL_COUNT=200
QUEUE_STALLED_INTERVAL_MS=30000
QUEUE_MAX_STALLED_COUNT=1
SHUTDOWN_GRACE_MS=15000
WORKER_SHUTDOWN_GRACE_MS=30000
RATE_LIMIT_AUTH_WINDOW_MS=15m
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_FAIL_MODE=closed
RATE_LIMIT_API_WINDOW_MS=60s
RATE_LIMIT_API_MAX_REQUESTS=120
RATE_LIMIT_API_FAIL_MODE=open
OPERATIONS_MAX_AUDIT_RANGE_DAYS=31
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
# PSQL_PATH=/usr/bin/psql
RETENTION_REFRESH_SESSION_DAYS=30
RETENTION_OPERATIONAL_FAILURE_DAYS=30
RETENTION_AGENT_EVENT_DAYS=0
RETENTION_EXPORT_DAYS=7
RETENTION_DRY_RUN=true
# Nested provider/model pricing map. Values are integer microunits per 1k tokens.
LLM_PRICING_JSON={"openai":{"gpt-4o-mini":{"inputMicrounitsPer1kTokens":150,"outputMicrounitsPer1kTokens":600}}}

# Demo seed login created by `pnpm db:seed`
# demo.owner@example.com / DemoPassword123!

# AI Provider - set to "openai" or "anthropic" to enable real LLM calls.
# Defaults to "deterministic" (no API calls; app is fully demoable without a key).
AI_PROVIDER=deterministic
# AI_API_KEY=sk-...          # OpenAI key, or Anthropic key - never commit this
# AI_MODEL_ROUTER=gpt-4o-mini
# AI_MODEL_RESOLVER=gpt-4o-mini
# AI_MODEL_CRITIC=gpt-4o-mini
# AI_TIMEOUT_MS=30000        # Per-call timeout (1000-120000)
# AI_ENABLE_FALLBACK=true    # Fall back to deterministic on LLM failure
# AI_MAX_OUTPUT_TOKENS=700
# AI_TEMPERATURE=0.2
