DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support
REDIS_HOST=localhost
REDIS_PORT=6379
API_BASE_URL=http://localhost:3001
# Auth placeholders only. Never commit real production secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set true in production behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# Demo seed login created by `pnpm db:seed`
# demo.owner@example.com / DemoPassword123!

# AI Provider - set to "openai" or "anthropic" to enable real LLM calls.
# Defaults to "deterministic" (no API calls; app is fully demoable without a key).
AI_PROVIDER=deterministic
# AI_API_KEY=sk-...          # OpenAI key, or Anthropic key - never commit this
# AI_MODEL_ROUTER=gpt-4o-mini
# AI_MODEL_RESOLVER=gpt-4o-mini
# AI_MODEL_CRITIC=gpt-4o-mini
# AI_TIMEOUT_MS=30000        # Per-call timeout (1000-120000)
# AI_ENABLE_FALLBACK=true    # Fall back to deterministic on LLM failure
# AI_MAX_OUTPUT_TOKENS=700
# AI_TEMPERATURE=0.2
